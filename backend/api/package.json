{
  "name":"@astakula/pdf-api",
  "version":"0.1.0",
  "private":true,
  "type":"module",
  "scripts":{
    "dev":"wrangler dev",
    "typecheck":"tsc --noEmit",
    "deploy:staging":"wrangler deploy",
    "db:migrate:local":"wrangler d1 migrations apply astakula-pdf-jobs-staging --local",
    "db:migrate:remote":"wrangler d1 migrations apply astakula-pdf-jobs-staging --remote"
  },
  "dependencies":{"@cloudflare/containers":"latest","hono":"^4.0.0"},
  "devDependencies":{"@cloudflare/workers-types":"latest","typescript":"^5.7.0","wrangler":"^4.0.0"}
}
